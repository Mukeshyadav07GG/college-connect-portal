{
  "version": 1,
  "sdk_version": "0.22.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://tixakhgfncvwsfyakdyy.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "knmiet-erp-mcp",
      "version": "0.1.0",
      "title": "KNMIET ERP"
    },
    "tools": [
      {
        "name": "get_my_profile",
        "title": "Get my profile",
        "description": "Return the signed-in user's KNMIET profile (name, roll/employee id, branch, semester, section) and role.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_announcements",
        "title": "List announcements",
        "description": "List the most recent KNMIET announcements visible to the signed-in user.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Maximum number of announcements to return (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_events",
        "title": "List events",
        "description": "List upcoming KNMIET events visible to the signed-in user.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Maximum number of events to return (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_faculty_directory",
        "title": "List faculty directory",
        "description": "List KNMIET faculty members (name, department, designation, email) visible to the signed-in user. Private fields like mobile numbers are never returned.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "upload_assignment",
        "title": "Upload assignment",
        "description": "Create an assignment for a chosen course, branch, subject, and deadline, and attach a file. The signed-in user must be faculty or admin. The file is uploaded to the private `assignments` storage bucket.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Assignment title."
            },
            "subject_code": {
              "type": "string",
              "minLength": 1,
              "description": "Canonical subject code from the subjects table, e.g. `KCS-601`."
            },
            "course": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Course, e.g. `B.Tech`."
            },
            "branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Branch, e.g. `CSE`."
            },
            "deadline": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "description": "Deadline as an ISO 8601 timestamp with timezone."
            },
            "description": {
              "description": "Optional description.",
              "type": "string",
              "maxLength": 4000
            },
            "file_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Original file name including extension."
            },
            "file_base64": {
              "type": "string",
              "minLength": 1,
              "description": "File contents as base64, either raw or a `data:<mime>;base64,...` URL."
            },
            "file_mime": {
              "description": "Optional MIME type (e.g. `application/pdf`). Defaults to `application/octet-stream`.",
              "type": "string"
            }
          },
          "required": [
            "title",
            "subject_code",
            "course",
            "branch",
            "deadline",
            "file_name",
            "file_base64"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
